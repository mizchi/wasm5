///|
test "bench_component_list_sum_small" (b : @bench.T) {
  let bytes = get_list_sum_wasm()
  let component = @wasm5_parse.parse_component(bytes)
  let rt = @wasm5_component.ComponentRuntime::new(component)
  rt.instantiate()
  let list = @wasm5_component.ComponentValue::List([
    b_s32(1),
    b_s32(2),
    b_s32(3),
    b_s32(4),
    b_s32(5),
  ])
  b.bench(
    name="component_list_sum_5",
    fn() {
      try {
        let result = rt.call("sum", [list])
        b.keep(result)
      } catch {
        _ => ()
      }
    },
  )
}

///|
test "bench_component_list_sum_medium" (b : @bench.T) {
  let bytes = get_list_sum_wasm()
  let component = @wasm5_parse.parse_component(bytes)
  let rt = @wasm5_component.ComponentRuntime::new(component)
  rt.instantiate()
  let items : Array[@wasm5_component.ComponentValue] = []
  for i = 0; i < 100; i = i + 1 {
    items.push(b_s32(i))
  }
  let list = @wasm5_component.ComponentValue::List(items)
  b.bench(
    name="component_list_sum_100",
    fn() {
      try {
        let result = rt.call("sum", [list])
        b.keep(result)
      } catch {
        _ => ()
      }
    },
  )
}

