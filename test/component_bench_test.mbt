// =============================================================================

///|
test "bench_component_call_100x" (b : @bench.T) {
  let bytes = get_with_canon_wasm()
  let component = @wasm5_parse.parse_component(bytes)
  let rt = @wasm5_component.ComponentRuntime::new(component)
  rt.instantiate()
  b.bench(
    name="component_call_100x",
    fn() {
      try {
        for _ in 0..<100 {
          let result = rt.call("add", [b_s32(1), b_s32(2)])
          b.keep(result)
        }
      } catch {
        _ => ()
      }
    },
  )
}

// =============================================================================
// Comparison: Core Module vs Component Call Overhead
// =============================================================================

///|
/// Simple add module (for comparison with component)
fn get_core_add_wasm() -> Bytes {
  b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x07\x01\x60\x02\x7f\x7f\x01\x7f\x03\x02\x01\x00\x07\x07\x01\x03\x61\x64\x64\x00\x00\x0a\x09\x01\x07\x00\x20\x00\x20\x01\x6a\x0b"
}

///|
test "bench_core_vs_component_add" (b : @bench.T) {
  // Core module add
  let core_bytes = get_core_add_wasm()
  let module_ = @wasm5_parse.parse(core_bytes)
  let core_rt = @wasm5_runtime.Runtime::load(module_)
  b.bench(
    name="core_add",
    fn() {
      try {
        let result = core_rt.call_compiled(
          b"add",
          [@wasm5_runtime.Value::I32(3U), @wasm5_runtime.Value::I32(5U)],
        )
        b.keep(result)
      } catch {
        _ => ()
      }
    },
  )
}

///|
test "bench_component_add_for_comparison" (b : @bench.T) {
  // Component add (same functionality)
  let comp_bytes = get_with_canon_wasm()
  let component = @wasm5_parse.parse_component(comp_bytes)
  let comp_rt = @wasm5_component.ComponentRuntime::new(component)
  comp_rt.instantiate()
  b.bench(
    name="component_add_compare",
    fn() {
      try {
        let result = comp_rt.call("add", [b_s32(3), b_s32(5)])
        b.keep(result)
      } catch {
        _ => ()
      }
    },
  )
}
